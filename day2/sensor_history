import pandas as pd
import joblib

from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix

# Load dataset
df = pd.read_csv("sensor_training_data.csv")

# Select features and target
features = [
    "temperature",
    "pressure",
    "vibration",
    "current",
    "rpm"
]

X = df[features]
y = df["state"]

# Split dataset
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

# Create model
model = RandomForestClassifier(
    n_estimators=100,
    max_depth=5,
    min_samples_leaf=5,
    random_state=42,
    class_weight="balanced"
)

# Train model
model.fit(X_train, y_train)

# Evaluate model
y_pred = model.predict(X_test)

accuracy = accuracy_score(y_test, y_pred)

print("========== MODEL EVALUATION ==========")
print(f"Total records: {len(df)}")
print(f"Training records: {len(X_train)}")
print(f"Testing records: {len(X_test)}")
print(f"Model Accuracy: {accuracy * 100:.2f}%")

print("\nClassification Report:")
print(classification_report(y_test, y_pred, zero_division=0))

print("Confusion Matrix:")
print(confusion_matrix(y_test, y_pred, labels=model.classes_))
print("Class order:", list(model.classes_))

# Save trained model
joblib.dump(model, "machine_state_model.pkl")

print("\nModel saved as machine_state_model.pkl")

# Predict a new sensor reading
new_sensor = pd.DataFrame([{
    "temperature": 90.0,
    "pressure": 5.0,
    "vibration": 2.5,
    "current": 12.0,
    "rpm": 1800
}])

prediction = model.predict(new_sensor)[0]

print("\nExample Sensor Reading:")
print(new_sensor.to_string(index=False))
print("Predicted state:", prediction)
